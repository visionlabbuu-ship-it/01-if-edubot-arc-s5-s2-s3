#!/usr/bin/env node

/**
 * ARC launcher.
 *
 * Keeps ARC isolated from any existing OpenClaude install by defaulting
 * CLAUDE_CONFIG_DIR to ~/.arc unless the caller explicitly overrides it.
 */

import { existsSync } from 'fs'
import { join, dirname, resolve } from 'path'
import { fileURLToPath, pathToFileURL } from 'url'
import { homedir } from 'os'

if (!process.env.CLAUDE_CONFIG_DIR) {
  process.env.CLAUDE_CONFIG_DIR = join(homedir(), '.arc')
}

const providerProfilePath = join(process.env.CLAUDE_CONFIG_DIR, '.arc-profile.json')
const hasSavedProviderProfile = existsSync(providerProfilePath)
const hasExplicitProviderSelection = [
  'CLAUDE_CODE_USE_OPENAI',
  'CLAUDE_CODE_USE_GITHUB',
  'CLAUDE_CODE_USE_GEMINI',
  'CLAUDE_CODE_USE_MISTRAL',
  'CLAUDE_CODE_USE_BEDROCK',
  'CLAUDE_CODE_USE_VERTEX',
  'CLAUDE_CODE_USE_FOUNDRY',
].some((name) => {
  const value = process.env[name]
  return value && !['0', 'false', 'no', 'off'].includes(value.trim().toLowerCase())
})
const hasAnthropicProviderConfig = Boolean(
  process.env.ANTHROPIC_BASE_URL ||
    process.env.ANTHROPIC_MODEL ||
    process.env.ANTHROPIC_API_KEY,
)

if (!hasSavedProviderProfile && !hasExplicitProviderSelection && !hasAnthropicProviderConfig) {
  process.env.CLAUDE_CODE_USE_OPENAI = '1'

  if (!process.env.OPENAI_BASE_URL) {
    process.env.OPENAI_BASE_URL = 'http://127.0.0.1:4000/v1'
  }

  if (!process.env.OPENAI_API_KEY) {
    process.env.OPENAI_API_KEY =
      'set-this-in-your-environment'
  }

  if (!process.env.OPENAI_MODEL) {
    process.env.OPENAI_MODEL = 'Qwen3.6'
  }
}

const __dirname = dirname(fileURLToPath(import.meta.url))
const defaultRobotWorkspace = resolve(__dirname, '..', '..', '..')

if (!process.env.ARC_ROBOT_WORKSPACE) {
  process.env.ARC_ROBOT_WORKSPACE = defaultRobotWorkspace
}

const distPath = join(__dirname, '..', 'dist', 'cli.mjs')

if (process.argv[2] === 'pipe') {
  let pipeWorkspace = process.env.ARC_ROBOT_WORKSPACE
  let pipeModulePath = join(
    pipeWorkspace,
    'benchmark',
    'telemetry',
    'arc_pipe.mjs',
  )
  if (!existsSync(pipeModulePath)) {
    pipeWorkspace = defaultRobotWorkspace
    process.env.ARC_ROBOT_WORKSPACE = pipeWorkspace
    pipeModulePath = join(
      pipeWorkspace,
      'benchmark',
      'telemetry',
      'arc_pipe.mjs',
    )
  }
  try {
    const { runArcPipe } = await import(pathToFileURL(pipeModulePath).href)
    await runArcPipe({
      launcherPath: fileURLToPath(import.meta.url),
      defaultWorkspace: defaultRobotWorkspace,
    })
  } catch (error) {
    console.error(`arc pipe: ${error instanceof Error ? error.message : String(error)}`)
    process.exitCode = 1
  }
} else if (existsSync(distPath)) {
  await import(pathToFileURL(distPath).href)
} else {
  console.error(`
  arc: dist/cli.mjs not found.

  Build first:
    bun run build

  Or run directly with Bun:
    bun run dev

  See README.md for setup instructions.
`)
  process.exit(1)
}
